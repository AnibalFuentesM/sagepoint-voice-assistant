{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "routes": [
    {
      "src": "^/(.*)$",
      "has": [
        {
          "type": "host",
          "value": "sagepoint-analytics.com"
        }
      ],
      "headers": {
        "Location": "https://www.sagepoint-analytics.com/$1"
      },
      "status": 308
    },
    {
      "src": "^/$",
      "has": [
        {
          "type": "query",
          "key": "lang",
          "value": "en"
        }
      ],
      "headers": {
        "Location": "/en/"
      },
      "status": 308
    },
    {
      "src": "^/portfolio/$",
      "has": [
        {
          "type": "query",
          "key": "lang",
          "value": "en"
        }
      ],
      "headers": {
        "Location": "/en/portfolio/"
      },
      "status": 308
    },
    {
      "src": "^/web/$",
      "has": [
        {
          "type": "query",
          "key": "lang",
          "value": "en"
        }
      ],
      "headers": {
        "Location": "/en/web/"
      },
      "status": 308
    },
    {
      "src": "^/portfolio$",
      "has": [
        {
          "type": "query",
          "key": "lang",
          "value": "en"
        }
      ],
      "headers": {
        "Location": "/en/portfolio/"
      },
      "status": 308
    },
    {
      "src": "^/web$",
      "has": [
        {
          "type": "query",
          "key": "lang",
          "value": "en"
        }
      ],
      "headers": {
        "Location": "/en/web/"
      },
      "status": 308
    },
    {
      "src": "^/portfolio$",
      "headers": {
        "Location": "/portfolio/"
      },
      "status": 308
    },
    {
      "src": "^/web$",
      "headers": {
        "Location": "/web/"
      },
      "status": 308
    },
    {
      "src": "^/servicios$",
      "headers": {
        "Location": "/servicios/"
      },
      "status": 308
    },
    {
      "src": "^/servicios/dashboards-power-bi-guatemala$",
      "headers": {
        "Location": "/servicios/dashboards-power-bi-guatemala/"
      },
      "status": 308
    },
    {
      "src": "^/servicios/automatizar-reportes-excel-sheets$",
      "headers": {
        "Location": "/servicios/automatizar-reportes-excel-sheets/"
      },
      "status": 308
    },
    {
      "src": "^/servicios/automatizacion-procesos-pymes$",
      "headers": {
        "Location": "/servicios/automatizacion-procesos-pymes/"
      },
      "status": 308
    },
    {
      "src": "^/en$",
      "headers": {
        "Location": "/en/"
      },
      "status": 308
    },
    {
      "src": "^/en/portfolio$",
      "headers": {
        "Location": "/en/portfolio/"
      },
      "status": 308
    },
    {
      "src": "^/en/web$",
      "headers": {
        "Location": "/en/web/"
      },
      "status": 308
    },
    {
      "src": "^/en/services$",
      "headers": {
        "Location": "/en/services/"
      },
      "status": 308
    },
    {
      "src": "^/en/services/call-center-kpi-dashboards$",
      "headers": {
        "Location": "/en/services/call-center-kpi-dashboards/"
      },
      "status": 308
    },
    {
      "src": "^/en/services/bpo-client-reporting-automation$",
      "headers": {
        "Location": "/en/services/bpo-client-reporting-automation/"
      },
      "status": 308
    },
    {
      "src": "^/assets/[^/]+-[A-Za-z0-9_-]{8}\\.(js|css)$",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      },
      "continue": true
    },
    {
      "src": "^/assets/img/(.*)$",
      "headers": {
        "Cache-Control": "public, max-age=0, must-revalidate"
      },
      "continue": true
    },
    {
      "src": "^/(favicon|logo|og-image)\\.png$",
      "headers": {
        "Cache-Control": "public, max-age=86400"
      },
      "continue": true
    },
    {
      "src": "^/$",
      "dest": "/index.html"
    },
    {
      "src": "^/portfolio/$",
      "dest": "/portfolio/index.html"
    },
    {
      "src": "^/web/$",
      "dest": "/web/index.html"
    },
    {
      "src": "^/servicios/$",
      "dest": "/servicios/index.html"
    },
    {
      "src": "^/servicios/dashboards-power-bi-guatemala/$",
      "dest": "/servicios/dashboards-power-bi-guatemala/index.html"
    },
    {
      "src": "^/servicios/automatizar-reportes-excel-sheets/$",
      "dest": "/servicios/automatizar-reportes-excel-sheets/index.html"
    },
    {
      "src": "^/servicios/automatizacion-procesos-pymes/$",
      "dest": "/servicios/automatizacion-procesos-pymes/index.html"
    },
    {
      "src": "^/en/$",
      "dest": "/en/index.html"
    },
    {
      "src": "^/en/portfolio/$",
      "dest": "/en/portfolio/index.html"
    },
    {
      "src": "^/en/web/$",
      "dest": "/en/web/index.html"
    },
    {
      "src": "^/en/services/$",
      "dest": "/en/services/index.html"
    },
    {
      "src": "^/en/services/call-center-kpi-dashboards/$",
      "dest": "/en/services/call-center-kpi-dashboards/index.html"
    },
    {
      "src": "^/en/services/bpo-client-reporting-automation/$",
      "dest": "/en/services/bpo-client-reporting-automation/index.html"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "^/.*$",
      "status": 404
    }
  ]
}
