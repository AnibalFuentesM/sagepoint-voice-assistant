{
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "sagepoint-analytics.com" }],
      "destination": "https://www.sagepoint-analytics.com/:path*",
      "permanent": true
    },
    {
      "source": "/web",
      "destination": "/web/",
      "permanent": true
    },
    {
      "source": "/portfolio",
      "destination": "/portfolio/",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/((?!assets/|projects/|favicon.png|logo.png|og-image.png|robots.txt|sitemap.xml|llms.txt).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(favicon.png|logo.png|og-image.png)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400" }
      ]
    }
  ]
}
